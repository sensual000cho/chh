{
  "name": "chh",
  "productName": "CHH",
  "version": "0.1.0",
  "description": "Excalidraw + PureRef 스타일 레퍼런스 보드",
  "main": "electron/main.cjs",
  "type": "module",
  "author": "CHH",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "cross-env CHH_DEV=1 electron .",
    "dist": "npm run build && electron-builder --win portable nsis && node scripts/publish.mjs",
    "gen:dark-css": "node scripts/gen-dark-css.mjs"
  },
  "devDependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "38.8.6",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.chh.app",
    "productName": "CHH",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "CHH-Setup.exe"
    },
    "portable": {
      "artifactName": "CHH.exe"
    },
    "electronLanguages": [
      "ko",
      "en-US"
    ]
  }
}
